<%= turbo_stream_from @dish %>

<div class="container py-5">

  <div class="text-center mb-4" id="dish-title">
    <h1 class="fw-bold">
      <%= @dish.name || "Analyse en cours…" %>
    </h1>

    <!-- SERVER TIMER -->
    <div id="analysis-timer">
      <%= render "dishes/timer", dish: @dish %>
    </div>

    <!-- CLIENT TIMER -->
    <div data-controller="analysis-timer"
         class="fs-4 fw-bold text-danger">
      <span data-analysis-timer-target="value">00:00</span>
    </div>
  </div>

  <div class="card shadow-sm mx-auto" style="max-width: 650px;">
    <div class="card-body">

      <div class="text-center mb-4">
        <% if @dish.image.attached? %>
          <%= image_tag @dish.image.variant(resize_to_fill: [300, 300]),
                class: "img-fluid rounded",
                style: "width: 300px; height: 300px; object-fit: cover;" %>
        <% end %>
      </div>

      <div id="analysis-results">
        <% if @dish.name.present? && @dish.name != "Analyse en cours…" %>
          <%= render "dishes/analysis_results", dish: @dish %>
        <% end %>
      </div>

      <div class="text-center mt-4">
        <%= link_to "Analyser un autre plat", new_dish_path, class: "btn btn-primary btn-lg" %>
      </div>

    </div>
  </div>

</div>
